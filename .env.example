# ---------------------------------------------------------------------------
# RetailPro environment variables
# Copy to .env for local development (server scripts load .env, not .env.local).
# Never commit real values.
# ---------------------------------------------------------------------------

# --- Turso Platform API (server only, NEVER expose as VITE_*) ---------------
# Organization-scoped token from https://app.turso.tech -> Settings -> Tokens
TURSO_API_TOKEN=
TURSO_ORG_SLUG=koncowebliberation
TURSO_GROUP=retailpro
TURSO_MAX_TENANT_DATABASES=99

# --- Control-plane database (Better Auth + tenant registry) -----------------
CONTROL_DB_URL=
CONTROL_DB_TOKEN=

# --- Better Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Client -----------------------------------------------------------------
# Only needed when the SPA runs on a different origin than the API.
VITE_API_BASE_URL=
