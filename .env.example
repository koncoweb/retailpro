# ---------------------------------------------------------------------------
# RetailPro environment variables
# Copy to .env for local development (server scripts load .env, not .env.local).
# Never commit real values. Diary of every variable: docs/backend.md §2.
# ---------------------------------------------------------------------------

# --- Turso Platform API (server only, NEVER expose as VITE_*) ---------------
# Organization-scoped token from https://app.turso.tech -> Settings -> Tokens
TURSO_API_TOKEN=
TURSO_ORG_SLUG=koncowebliberation

# Group every database is created in. It must already exist in the
# organization: `curl /v1/organizations/<org>/groups` lists them. A brand new
# organization only has its automatically created location group, e.g.
# ap-southeast-2 — there is no `default` group.
TURSO_GROUP=ap-southeast-2
TURSO_MAX_TENANT_DATABASES=99

# --- Control-plane database (Better Auth + tenant registry) -----------------
# Local file: file:./.data/control.db (needs scripts/dev-db-server.mjs)
# Cloud:     https://<control-db>-<org>.aws-<region>.turso.io
CONTROL_DB_URL=
CONTROL_DB_TOKEN=

# --- Better Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Must be the origin the browser uses: http://localhost:3000 locally,
# https://<back-office-domain> in production (cookies + trusted origins).
BETTER_AUTH_URL=http://localhost:3000

# --- Tenant tokens & storefront --------------------------------------------
# Lifetime of the token handed to the browser (default 60m).
TENANT_TOKEN_TTL=60m
# Tenant served by GET /api/storefront/catalog when no ?slug= is given.
STOREFRONT_TENANT_SLUG=thalia

# --- Client -----------------------------------------------------------------
# Only needed when the SPA runs on a different origin than the API.
VITE_API_BASE_URL=
# Dev server proxy target for /api (default http://localhost:3000).
VITE_API_PROXY_TARGET=

# --- Storefront app (tokoonline/) ------------------------------------------
# Not read by this project. Set it in tokoonline/.env locally and in the
# thalia-storefront Vercel project; the value is baked into the bundle at build
# time (default in tokoonline: http://localhost:3000). See docs/deployment.md §4.
# VITE_CATALOG_API_URL=https://retailpro-thalia.vercel.app
